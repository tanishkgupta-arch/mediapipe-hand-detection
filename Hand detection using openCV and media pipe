# Wap to create finger counter using mediapipe 
# camera detection - detect hands - find landmarks - set positions- count fingers - display the number
'''
import cv2 
import mediapipe as mp
'''
# mediapipe will help in the hand detection and setting landmarks and coordinates 
# cv2 will help in image proccesing, capturing camera and display output 
'''
hands=mp.solutions.hands.Hands(max_num_hands=1)
'''
# it will create a hand detection model 
'''
draw=mp.solutions.drawing_utils
'''
# this module draw hand points and lines between fingers 
'''
cap=cv2.VideoCapture(0) # using default web cam.
while True:  # making a loop till the situation fails 
    ret,img=cap.read()
    img=cv2.flip(img,1)
    RGB=cv2.cvtColor(img,cv2.COLOR_BGR2RGB)
    result=hands.proccess(RGB)
    count=0
    if result.multi_hand_landmarks:
        for hand in result.multi_hand_landmarks:
            lm=hand.landmark
            if lm[4].x>lm[3].x:
                count=count+1 #Thumb
            for tip,joint in[(8,6),(12,10),(16,14)(20,18)]:
                if lm [tip].y>lm[joint].y:
                    count=count+1 # 4 finger's
            # draw landmarks
            draw.draw_landmarks(img,hand,mp.solutions.hands.HAND_CONNECTIONS)
    cv2.putText(img,"fingers"+str(count)(20,50),cv2.FONT_HERSHEY_SIMPLEX,1.5,(0,255,0),3)
    cv2.imshow("finger counter",img)
    if cv2.waitKey(1)& 0xff==ord('q'):
        break
cap.release()
cv2.destroyAllWindows()
